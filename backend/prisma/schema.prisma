// EHB HR Self-Service Portal — Phase 1 schema
// (profiles, attendance, attendance update, leave, approvals, letters, pay slips, documents)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  LINE_MANAGER
  HOD
  HR
  FINANCE
  ADMIN
  MANAGEMENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  hodId     Int?
  hod       Employee?  @relation("DepartmentHod", fields: [hodId], references: [id])
  employees Employee[] @relation("DepartmentMembers")
  createdAt DateTime   @default(now())

  assetAssignments    AssetAssignment[]
  performanceTemplate PerformanceTemplate?
  approvedHeadcount   Int? // maintained by HR; empty = no limit
  requisitions        Requisition[]
}

model Employee {
  id                 Int            @id @default(autoincrement())
  code               String         @unique // EHB-2026-001
  email              String         @unique // work email, used to log in
  passwordHash       String
  mustChangePassword Boolean        @default(true)
  roles              Role[]         @default([EMPLOYEE])
  status             EmployeeStatus @default(ACTIVE)

  fullName         String
  fatherName       String?
  gender           Gender?
  dateOfBirth      DateTime? @db.Date
  designation      String?
  joiningDate      DateTime  @db.Date
  // Resignation notice: the probation notice period applies until this date (empty = confirmed)
  probationEndDate    DateTime? @db.Date
  // HR's formal confirmation (Module: Probation confirmation). Empty while on probation or still due.
  confirmedAt         DateTime?
  // So the Line Manager (or HR, with no manager) is told once per due cycle, not on every run of the daily job
  probationNotifiedAt DateTime?
  // Hiring: the grade replacements keep by default, and since when the employee is in their current role
  grade            String?
  roleSince        DateTime? @db.Date // empty = joining date; set again by an internal move

  departmentId Int?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  managerId    Int?
  manager      Employee?   @relation("LineManager", fields: [managerId], references: [id])
  reports      Employee[]  @relation("LineManager")

  machineId String? @unique // biometric machine ID

  // Contact details: editable by the employee
  phone                 String?
  personalEmail         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Sensitive: HR only (CNIC / family) and HR + payroll (bank)
  cnic          String?
  maritalStatus String?
  familyDetails String?
  bankName      String?
  bankAccount   String?

  // Salary: visible to the employee, HR, Finance, Management
  basicSalary Decimal? @db.Decimal(12, 2)
  grossSalary Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  headOf                  Department[]          @relation("DepartmentHod")
  attendance              AttendanceRecord[]
  leaveBalances           LeaveBalance[]
  requests                Request[]             @relation("Requester")
  stepsToApprove          RequestStep[]         @relation("StepApprover")
  stepsActed              RequestStep[]         @relation("StepActor")
  actions                 RequestAction[]
  payslips                Payslip[]
  lateWarnings            LateWarning[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  documents               Document[]
  expensesPaid            ExpenseClaim[]        @relation("ExpensePaidBy")
  travelAdvancesPaid      TravelRequest[]       @relation("TravelAdvancePaidBy")
  travelAdvanceReturns    TravelRequest[]       @relation("TravelAdvanceReturnedBy")
  travelBooked            TravelRequest[]       @relation("TravelBookedBy")
  travelCancelled         TravelRequest[]       @relation("TravelCancelledBy")
  travelBookingsCreated   TravelBooking[]
  assetsHeld              AssetAssignment[]     @relation("AssetHolder")
  assetsIssued            AssetAssignment[]     @relation("AssetIssuer")
  assetsReceived          AssetAssignment[]     @relation("AssetReceiver")
  assetRepairsLogged      AssetRepair[]
  assetIncidentsAbout     AssetIncident[]       @relation("IncidentEmployee")
  assetIncidentsReported  AssetIncident[]       @relation("IncidentReporter")
  assetIncidentsRecorded  AssetIncident[]       @relation("IncidentRecorder")
  assetRecoveriesSet      AssetIncident[]       @relation("IncidentRecoverySetter")
  assetWriteOffs          AssetIncident[]       @relation("IncidentWriteOff")
  exits                   ExitCase[]            @relation("ExitEmployee")
  exitsStarted            ExitCase[]            @relation("ExitStartedBy")
  exitsCompleted          ExitCase[]            @relation("ExitCompletedBy")
  exitsCancelled          ExitCase[]            @relation("ExitCancelledBy")
  exitLettersIssued       ExitCase[]            @relation("ExitLettersBy")
  exitsSettled            ExitCase[]            @relation("ExitSettledBy")
  clearancesToApprove     ExitClearance[]       @relation("ClearanceApprover")
  clearancesCleared       ExitClearance[]       @relation("ClearanceClearedBy")
  exitInterviewsRecorded  ExitInterview[]
  scorecards              Scorecard[]           @relation("ScorecardEmployee")
  cyclesCreated           PerformanceCycle[]
  scorecardGoalsSet       Scorecard[]           @relation("ScorecardGoalsSetBy")
  scorecardsReviewed      Scorecard[]           @relation("ScorecardReviewedBy")
  scorecardAppealsDecided Scorecard[]           @relation("ScorecardAppealDecidedBy")
  scorecardCheckIns       ScorecardCheckIn[]
  ratingAdjustments       RatingAdjustment[]
  performanceTemplates    PerformanceTemplate[]
  requisitionsRaised      Requisition[]         @relation("RequisitionRequester")
  requisitionsReporting   Requisition[]         @relation("RequisitionReportsTo")
  requisitionsReplacing   Requisition[]         @relation("RequisitionReplaces")
  requisitionsBudgeted    Requisition[]         @relation("RequisitionBudgetBy")
  requisitionsPosted      Requisition[]         @relation("RequisitionPostedBy")
  requisitionsClosed      Requisition[]         @relation("RequisitionClosedBy")
  jobApplications         JobApplication[]      @relation("ApplicationApplicant")
  hiredFromApplications   JobApplication[]      @relation("ApplicationHired")
  applicationEvents       ApplicationEvent[]
  interviewFeedback       InterviewFeedback[]
  probationDecisions      ProbationDecision[]   @relation("ProbationEmployee")
  probationDecisionsMade  ProbationDecision[]   @relation("ProbationDecidedBy")
  probationNotes          ProbationNote[]       @relation("ProbationNoteEmployee")
  probationNotesWritten   ProbationNote[]       @relation("ProbationNoteAuthor")
}

/**
 * HR's formal confirm/extend decision once probation ends, with the reason for an extension.
 */
model ProbationDecision {
  id                       Int       @id @default(autoincrement())
  employeeId               Int
  employee                 Employee  @relation("ProbationEmployee", fields: [employeeId], references: [id])
  kind                     String // CONFIRMED or EXTENDED
  previousProbationEndDate DateTime? @db.Date
  newProbationEndDate      DateTime? @db.Date // set for EXTENDED, empty for CONFIRMED
  reason                   String? // required for EXTENDED
  decidedById              Int
  decidedBy                Employee  @relation("ProbationDecidedBy", fields: [decidedById], references: [id])
  createdAt                DateTime  @default(now())
}

/**
 * The Line Manager's optional note for HR before a confirmation decision. Not an approval step; HR
 * still has the final say. Visible to HR and the employee's Line Manager only, never the employee.
 */
model ProbationNote {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation("ProbationNoteEmployee", fields: [employeeId], references: [id])
  authorId   Int
  author     Employee @relation("ProbationNoteAuthor", fields: [authorId], references: [id])
  comment    String
  createdAt  DateTime @default(now())
}

// HR-editable rules (late cutoff, hour thresholds, limits...). Every quota/limit is a setting.
model Setting {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String
}

enum AttendanceStatus {
  ON_TIME
  LATE
  HALF_DAY
  ABSENT
}

model AttendanceImport {
  id           Int                @id @default(autoincrement())
  fileName     String
  importedById Int
  rowsRead     Int
  rowsImported Int
  unmatchedIds String[]
  fromDate     DateTime?          @db.Date
  toDate       DateTime?          @db.Date
  createdAt    DateTime           @default(now())
  records      AttendanceRecord[]
}

// One row per employee per day from the biometric import. The original machine values are never
// overwritten; an approved Attendance Update fills the corrected* fields instead.
model AttendanceRecord {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id])
  date       DateTime          @db.Date
  checkIn    Int? // minutes from midnight
  checkOut   Int?
  status     AttendanceStatus
  importId   Int?
  import     AttendanceImport? @relation(fields: [importId], references: [id])

  correctedCheckIn    Int?
  correctedCheckOut   Int?
  correctedStatus     AttendanceStatus?
  correctionRequestId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model LateWarning {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  month      Int
  lateCount  Int
  createdAt  DateTime @default(now())

  @@unique([employeeId, year, month])
}

model LeaveType {
  id                Int            @id @default(autoincrement())
  code              String         @unique // AL, CL, SL, LWP, ML, PL
  name              String
  annualQuota       Decimal?       @db.Decimal(5, 1) // null = no fixed quota (e.g. LWP)
  paid              Boolean        @default(true)
  needsHrApproval   Boolean        @default(false)
  noticeDays        Int            @default(0)
  documentAfterDays Int? // e.g. SL: certificate needed above 2 days
  carryForwardMax   Decimal?       @db.Decimal(5, 1)
  proRata           Boolean        @default(true)
  gender            Gender?
  active            Boolean        @default(true)
  balances          LeaveBalance[]
  leaveRequests     LeaveRequest[]
}

model LeaveBalance {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId    Int
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  entitled       Decimal   @db.Decimal(5, 1)
  carriedForward Decimal   @default(0) @db.Decimal(5, 1)
  used           Decimal   @default(0) @db.Decimal(5, 1)
  // Set when HR adjusts the entitlement by hand; automatic recalculation then leaves it alone.
  entitledManual Boolean   @default(false)

  @@unique([employeeId, leaveTypeId, year])
}

// ---------- Approval engine ----------

enum RequestType {
  LEAVE
  ATTENDANCE_UPDATE
  LETTER
  EXPENSE
  TRAVEL
  TRAVEL_SETTLEMENT
  ASSET_REQUEST
  RESIGNATION
  PERFORMANCE_GOALS
  PERFORMANCE_REVIEW
  MANPOWER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum StepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
}

model Request {
  id          Int           @id @default(autoincrement())
  type        RequestType
  employeeId  Int
  employee    Employee      @relation("Requester", fields: [employeeId], references: [id])
  status      RequestStatus @default(PENDING)
  currentStep Int           @default(0)
  title       String
  data        Json          @default("{}")
  outputPath  String? // generated letter PDF
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  steps                   RequestStep[]
  actions                 RequestAction[]
  attachments             RequestAttachment[]
  leaveRequest            LeaveRequest?
  attendanceUpdateRequest AttendanceUpdateRequest?
  expenseClaim            ExpenseClaim?
  travelRequest           TravelRequest?
  assetRequest            AssetRequest?
  resignation             ResignationRequest?
  exitCase                ExitCase?
  scorecardGoals          Scorecard?               @relation("ScorecardGoals")
  scorecardReview         Scorecard?               @relation("ScorecardReview")
  requisition             Requisition?

  @@index([employeeId, status])
}

model RequestStep {
  id                    Int        @id @default(autoincrement())
  requestId             Int
  request               Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order                 Int
  label                 String // "Line Manager", "HR"...
  approverId            Int? // specific person (line manager / HOD)
  approver              Employee?  @relation("StepApprover", fields: [approverId], references: [id])
  approverRole          Role? // or anyone holding this role (HR, Finance)
  status                StepStatus @default(WAITING)
  actedById             Int?
  actedBy               Employee?  @relation("StepActor", fields: [actedById], references: [id])
  actedAt               DateTime?
  comment               String?
  pendingSince          DateTime?
  lastReminderAt        DateTime?
  // Role steps only: people who approved an earlier step of this request may not act on this one
  // (e.g. the Finance step). If nobody is left, the step goes to fallbackRole instead (e.g. Management).
  excludePriorApprovers Boolean    @default(false)
  fallbackRole          Role?
  fallbackLabel         String?

  @@unique([requestId, order])
  @@index([approverId, status])
}

model RequestAction {
  id        Int      @id @default(autoincrement())
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     Employee @relation(fields: [actorId], references: [id])
  action    String // SUBMITTED, APPROVED, REJECTED, RETURNED, RESUBMITTED, CANCELLED
  stepOrder Int?
  comment   String?
  createdAt DateTime @default(now())
}

model RequestAttachment {
  id        Int      @id @default(autoincrement())
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  expenseLines   ExpenseLine[]
  travelVouchers TravelBooking[]
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  requestId   Int       @unique
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  days        Decimal   @db.Decimal(5, 1)
  reason      String
}

enum AttendanceUpdateKind {
  MISSED_PUNCH
  FIELD_VISIT
  OTHER
}

model AttendanceUpdateRequest {
  id        Int                  @id @default(autoincrement())
  requestId Int                  @unique
  request   Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date      DateTime             @db.Date
  kind      AttendanceUpdateKind
  checkIn   Int?
  checkOut  Int?
  reason    String
}

// ---------- Pay slips ----------

model PayrollUpload {
  id           Int       @id @default(autoincrement())
  year         Int
  month        Int
  fileName     String
  uploadedById Int
  rowsImported Int
  unmatched    String[]
  createdAt    DateTime  @default(now())
  payslips     Payslip[]
}

model Payslip {
  id         Int           @id @default(autoincrement())
  employeeId Int
  employee   Employee      @relation(fields: [employeeId], references: [id])
  uploadId   Int
  upload     PayrollUpload @relation(fields: [uploadId], references: [id])
  year       Int
  month      Int

  basic      Decimal @default(0) @db.Decimal(12, 2)
  houseRent  Decimal @default(0) @db.Decimal(12, 2)
  medical    Decimal @default(0) @db.Decimal(12, 2)
  conveyance Decimal @default(0) @db.Decimal(12, 2)
  fuel       Decimal @default(0) @db.Decimal(12, 2)
  mobile     Decimal @default(0) @db.Decimal(12, 2)
  gross      Decimal @default(0) @db.Decimal(12, 2)

  incomeTax       Decimal @default(0) @db.Decimal(12, 2)
  eobi            Decimal @default(0) @db.Decimal(12, 2)
  providentFund   Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay          Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([employeeId, year, month])
}

// ---------- Policies and HR documents ----------

enum DocumentCategory {
  POLICY
  HR_FORM
}

model Document {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?
  category     DocumentCategory
  fileName     String
  path         String
  mimeType     String
  size         Int
  uploadedById Int
  uploadedBy   Employee         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
}

// ---------- Notifications and audit ----------

model Notification {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  body       String
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, read])
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  actorId   Int?
  actor     Employee? @relation(fields: [actorId], references: [id])
  action    String // CREATE, UPDATE, VIEW_SENSITIVE, IMPORT, LOGIN...
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
}

// ---------- Expense claims (Phase 2) ----------

// Editable by HR / Finance. monthlyLimit is per employee per calendar month (null = no limit).
model ExpenseCategory {
  id               Int           @id @default(autoincrement())
  name             String        @unique
  accountingCode   String?
  monthlyLimit     Decimal?      @db.Decimal(12, 2)
  // Already paid as a salary allowance (fuel, mobile): claims show a warning and need a justification.
  allowanceWarning Boolean       @default(false)
  active           Boolean       @default(true)
  sortOrder        Int           @default(0)
  // LOCAL = Expense Claim, TRAVEL = trip settlement
  scope            ExpenseScope  @default(LOCAL)
  // Travel: not claimable when the daily allowance (per diem) is in use, e.g. meals
  coveredByPerDiem Boolean       @default(false)
  lines            ExpenseLine[]
}

enum PaymentMethod {
  BANK_TRANSFER
  WITH_SALARY
  CASH
}

enum ExpenseLineStatus {
  CLAIMED
  REDUCED
  REJECTED
}

model ExpenseClaim {
  id               Int            @id @default(autoincrement())
  requestId        Int            @unique
  request          Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purpose          String
  totalClaimed     Decimal        @db.Decimal(12, 2)
  paidOn           DateTime?      @db.Date
  paymentMethod    PaymentMethod?
  paymentReference String?
  paidAt           DateTime?
  paidById         Int?
  paidBy           Employee?      @relation("ExpensePaidBy", fields: [paidById], references: [id])
  // Set for a travel settlement: the trip it settles
  travelId         Int?           @unique
  travel           TravelRequest? @relation(fields: [travelId], references: [id])
  lines            ExpenseLine[]
}

model ExpenseLine {
  id                     Int                @id @default(autoincrement())
  claimId                Int
  claim                  ExpenseClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  order                  Int
  date                   DateTime           @db.Date
  // STANDARD lines have a category; HOTEL (nights), PER_DIEM (days) and MILEAGE (km) use quantity × rate
  kind                   ExpenseLineKind    @default(STANDARD)
  categoryId             Int?
  category               ExpenseCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quantity               Decimal?           @db.Decimal(10, 2)
  rate                   Decimal?           @db.Decimal(12, 2)
  description            String
  amount                 Decimal            @db.Decimal(12, 2)
  // Only Finance changes these: REDUCED sets approvedAmount, REJECTED sets it to 0; financeReason is required.
  status                 ExpenseLineStatus  @default(CLAIMED)
  approvedAmount         Decimal?           @db.Decimal(12, 2)
  financeReason          String?
  noReceiptExplanation   String?
  allowanceJustification String?
  receiptId              Int?
  receipt                RequestAttachment? @relation(fields: [receiptId], references: [id])

  @@index([claimId])
  @@index([date])
}

// ---------- Travel (Phase 2) ----------

enum ExpenseScope {
  LOCAL
  TRAVEL
}

enum ExpenseLineKind {
  STANDARD
  HOTEL
  PER_DIEM
  MILEAGE
}

enum TravelMode {
  AIR
  TRAIN
  BUS
  COMPANY_CAR
  OWN_CAR
  OTHER
}

enum BookingStatus {
  NOT_NEEDED
  PENDING
  BOOKED
}

enum BookingKind {
  AIR
  TRAIN
  BUS
  HOTEL
}

enum BookingArranger {
  ADMIN
  EMPLOYEE
}

enum AdvanceReturnMethod {
  CASH_OR_BANK
  SALARY_DEDUCTION
}

// Pre-trip request. Amounts are PKR; country is kept so international travel can be added later.
model TravelRequest {
  id                Int        @id @default(autoincrement())
  requestId         Int        @unique
  request           Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purpose           String
  origin            String
  destination       String
  country           String     @default("PK")
  departDate        DateTime   @db.Date
  returnDate        DateTime   @db.Date
  mode              TravelMode
  needsHotel        Boolean    @default(false)
  estimateTransport Decimal    @default(0) @db.Decimal(12, 2)
  estimateHotel     Decimal    @default(0) @db.Decimal(12, 2)
  estimateMeals     Decimal    @default(0) @db.Decimal(12, 2)
  estimateOther     Decimal    @default(0) @db.Decimal(12, 2)
  estimatedTotal    Decimal    @db.Decimal(12, 2)

  advanceRequested       Decimal              @default(0) @db.Decimal(12, 2)
  advancePaidOn          DateTime?            @db.Date
  advanceMethod          PaymentMethod?
  advanceReference       String?
  advancePaidAt          DateTime?
  advancePaidById        Int?
  advancePaidBy          Employee?            @relation("TravelAdvancePaidBy", fields: [advancePaidById], references: [id])
  advanceReturnedAmount  Decimal?             @db.Decimal(12, 2)
  advanceReturnMethod    AdvanceReturnMethod?
  advanceReturnedOn      DateTime?            @db.Date
  advanceReturnReference String?
  advanceReturnedById    Int?
  advanceReturnedBy      Employee?            @relation("TravelAdvanceReturnedBy", fields: [advanceReturnedById], references: [id])

  bookingStatus BookingStatus @default(NOT_NEEDED)
  bookedAt      DateTime?
  bookedById    Int?
  bookedBy      Employee?     @relation("TravelBookedBy", fields: [bookedById], references: [id])

  cancelledAt         DateTime?
  cancelledById       Int?
  cancelledBy         Employee? @relation("TravelCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason  String?
  // Recorded by Admin; the company bears it. Finance can add a note.
  cancellationFee     Decimal?  @db.Decimal(12, 2)
  cancellationFeeNote String?
  financeNote         String?

  bookings   TravelBooking[]
  settlement ExpenseClaim?

  @@index([departDate, returnDate])
}

// One booked item. arrangedBy EMPLOYEE = "employee to arrange": they book it and claim it in the settlement.
model TravelBooking {
  id          Int                @id @default(autoincrement())
  travelId    Int
  travel      TravelRequest      @relation(fields: [travelId], references: [id], onDelete: Cascade)
  kind        BookingKind
  arrangedBy  BookingArranger
  details     String
  provider    String?
  reference   String?
  cost        Decimal?           @db.Decimal(12, 2)
  voucherId   Int?
  voucher     RequestAttachment? @relation(fields: [voucherId], references: [id])
  createdById Int
  createdBy   Employee           @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())

  @@index([travelId])
}

// ---------- My Inventory / company assets (Phase 2) ----------

enum AssetKind {
  PHYSICAL
  ACCESS // email, software, system access: "returned" means revoked by IT / Admin
}

enum AssetStatus {
  IN_STOCK
  ISSUED
  IN_REPAIR
  LOST
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum AssigneeType {
  EMPLOYEE
  DEPARTMENT
  LOCATION
}

enum IncidentType {
  NOT_WORKING
  DAMAGED
  LOST
}

// REPORTED (by the employee) -> RECORDED (Admin confirms) -> RECOVERY_SET (HR) or WRITTEN_OFF (Management); CLOSED = no damage
enum IncidentStatus {
  REPORTED
  RECORDED
  RECOVERY_SET
  WRITTEN_OFF
  CLOSED
}

model AssetCategory {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  kind             AssetKind      @default(PHYSICAL)
  // Exit clearance waits for these items to be returned (or revoked), written off or charged.
  mustReturnOnExit Boolean        @default(true)
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  assets           Asset[]
  requests         AssetRequest[]
}

model Asset {
  id              Int            @id @default(autoincrement())
  tag             String         @unique // existing tag, or generated EHB-AST-0001
  categoryId      Int
  category        AssetCategory  @relation(fields: [categoryId], references: [id])
  name            String // make / model, or the account / software name
  serialNumber    String?
  purchaseDate    DateTime?      @db.Date
  cost            Decimal?       @db.Decimal(12, 2) // visible to Admin, Finance and Management only
  warrantyUntil   DateTime?      @db.Date
  condition       AssetCondition @default(GOOD)
  status          AssetStatus    @default(IN_STOCK)
  storageLocation String? // where it is kept when in stock
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignments AssetAssignment[]
  repairs     AssetRepair[]
  incidents   AssetIncident[]

  @@index([status])
  @@index([categoryId])
}

// Who had the item and when. Never overwritten: a return closes the row, a new issue adds one.
model AssetAssignment {
  id           Int             @id @default(autoincrement())
  assetId      Int
  asset        Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assigneeType AssigneeType
  employeeId   Int?
  employee     Employee?       @relation("AssetHolder", fields: [employeeId], references: [id])
  departmentId Int?
  department   Department?     @relation(fields: [departmentId], references: [id])
  location     String?
  issuedAt     DateTime        @default(now())
  issuedById   Int
  issuedBy     Employee        @relation("AssetIssuer", fields: [issuedById], references: [id])
  conditionOut AssetCondition
  issueNote    String?
  confirmedAt  DateTime? // the employee confirms receipt (automatic for access, departments and locations)
  returnedAt   DateTime?
  receivedById Int?
  receivedBy   Employee?       @relation("AssetReceiver", fields: [receivedById], references: [id])
  conditionIn  AssetCondition?
  returnNote   String?

  incidents AssetIncident[]
  request   AssetRequest?

  @@index([employeeId, returnedAt])
  @@index([assetId, returnedAt])
}

model AssetRepair {
  id          Int       @id @default(autoincrement())
  assetId     Int
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor      String
  sentOn      DateTime  @db.Date
  returnedOn  DateTime? @db.Date
  cost        Decimal?  @db.Decimal(12, 2)
  note        String?
  createdById Int
  createdBy   Employee  @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// Damage or loss. Admin records it, HR sets a recovery amount (sent to Finance for the final settlement),
// or Management writes it off.
model AssetIncident {
  id              Int              @id @default(autoincrement())
  assetId         Int
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignmentId    Int?
  assignment      AssetAssignment? @relation(fields: [assignmentId], references: [id])
  employeeId      Int? // the person responsible (the holder at the time)
  employee        Employee?        @relation("IncidentEmployee", fields: [employeeId], references: [id])
  type            IncidentType
  status          IncidentStatus
  description     String
  reportedById    Int
  reportedBy      Employee         @relation("IncidentReporter", fields: [reportedById], references: [id])
  createdAt       DateTime         @default(now())
  recordedById    Int?
  recordedBy      Employee?        @relation("IncidentRecorder", fields: [recordedById], references: [id])
  recordedAt      DateTime?
  adminNote       String?
  recoveryAmount  Decimal?         @db.Decimal(12, 2)
  recoverySetById Int?
  recoverySetBy   Employee?        @relation("IncidentRecoverySetter", fields: [recoverySetById], references: [id])
  recoverySetAt   DateTime?
  recoveryNote    String?
  writtenOffById  Int?
  writtenOffBy    Employee?        @relation("IncidentWriteOff", fields: [writtenOffById], references: [id])
  writtenOffAt    DateTime?
  writeOffNote    String?

  @@index([status])
  @@index([employeeId])
}

// Employee asks for an asset: Line Manager → Admin. Admin then issues an item (fulfilment).
model AssetRequest {
  id           Int              @id @default(autoincrement())
  requestId    Int              @unique
  request      Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  categoryId   Int
  category     AssetCategory    @relation(fields: [categoryId], references: [id])
  reason       String
  neededBy     DateTime?        @db.Date
  assignmentId Int?             @unique
  assignment   AssetAssignment? @relation(fields: [assignmentId], references: [id])
}

// ---------------------------------------------------------------------------
// Resignation & exit clearance
// ---------------------------------------------------------------------------

enum ExitType {
  RESIGNATION
  TERMINATION
  END_OF_CONTRACT
  OTHER
}

enum ExitStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ClearanceArea {
  IT_ADMIN
  LINE_MANAGER
  HR
  FINANCE
}

enum ClearanceStatus {
  WAITING // Finance waits until the other three have cleared
  PENDING
  CLEARED
}

enum SettlementItemKind {
  ASSET_RECOVERY
  TRAVEL_ADVANCE
  NOTICE_SHORTFALL
  LEAVE_ENCASHMENT
  EXPENSE_PAYABLE
  OTHER
}

enum SettlementDirection {
  DEDUCT // the employee owes the company
  PAY // the company owes the employee
}

/**
 * The resignation form: Line Manager -> HOD (Management for an HOD) -> HR.
 */
model ResignationRequest {
  id                      Int      @id @default(autoincrement())
  requestId               Int      @unique
  request                 Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reason                  String
  resignationDate         DateTime @db.Date // the day notice was given
  proposedLastDay         DateTime @db.Date
  onProbation             Boolean  @default(false)
  noticeDays              Int
  noticeEndDate           DateTime @db.Date
  // Asked of the Line Manager when the proposed last day is before the notice period ends
  earlyReleaseRecommended Boolean?
}

/**
 * Opened when HR approves a resignation, or started by HR for another reason.
 */
model ExitCase {
  id              Int        @id @default(autoincrement())
  employeeId      Int
  employee        Employee   @relation("ExitEmployee", fields: [employeeId], references: [id])
  type            ExitType
  reason          String
  requestId       Int?       @unique
  request         Request?   @relation(fields: [requestId], references: [id])
  noticeGivenOn   DateTime   @db.Date
  noticeDays      Int        @default(0)
  noticeEndDate   DateTime?  @db.Date
  lastWorkingDay  DateTime   @db.Date
  shortfallDays   Int        @default(0) // notice not served; Finance deducts it unless HR waived it
  shortfallWaived Boolean    @default(false)
  status          ExitStatus @default(OPEN)
  startedById     Int
  startedBy       Employee   @relation("ExitStartedBy", fields: [startedById], references: [id])
  createdAt       DateTime   @default(now())
  deactivatedAt   DateTime? // login switched off after the last working day

  completedAt   DateTime?
  completedById Int?
  completedBy   Employee? @relation("ExitCompletedBy", fields: [completedById], references: [id])
  cancelledAt   DateTime?
  cancelledById Int?
  cancelledBy   Employee? @relation("ExitCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  lettersIssuedAt   DateTime?
  lettersIssuedById Int?
  lettersIssuedBy   Employee? @relation("ExitLettersBy", fields: [lettersIssuedById], references: [id])
  lettersEmailedTo  String?

  // Final settlement, recorded by Finance (the portal does not calculate salary)
  settlementNet       Decimal?  @db.Decimal(12, 2) // positive: paid to the employee; negative: owed by the employee
  settlementPaidOn    DateTime? @db.Date
  settlementMethod    String?
  settlementReference String?
  settlementNote      String?
  settledAt           DateTime?
  settledById         Int?
  settledBy           Employee? @relation("ExitSettledBy", fields: [settledById], references: [id])

  clearances      ExitClearance[]
  settlementItems ExitSettlementItem[]
  interview       ExitInterview?
  replacements    Requisition[]

  @@index([employeeId, status])
}

model ExitClearance {
  id          Int             @id @default(autoincrement())
  caseId      Int
  case        ExitCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  area        ClearanceArea
  status      ClearanceStatus
  approverId  Int? // Line Manager card: the manager when the case opened
  approver    Employee?       @relation("ClearanceApprover", fields: [approverId], references: [id])
  clearedById Int?
  clearedBy   Employee?       @relation("ClearanceClearedBy", fields: [clearedById], references: [id])
  clearedAt   DateTime?
  comment     String?

  @@unique([caseId, area])
}

model ExitSettlementItem {
  id          Int                 @id @default(autoincrement())
  caseId      Int
  case        ExitCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  order       Int
  kind        SettlementItemKind
  direction   SettlementDirection
  description String
  days        Decimal?            @db.Decimal(6, 1)
  amount      Decimal             @db.Decimal(12, 2)
}

/**
 * Optional; visible to HR only.
 */
model ExitInterview {
  id             Int      @id @default(autoincrement())
  caseId         Int      @unique
  case           ExitCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  primaryReason  String
  rating         Int? // overall experience, 1-5
  wouldRecommend Boolean?
  wouldReturn    Boolean?
  likedMost      String?
  improve        String?
  comments       String?
  recordedById   Int
  recordedBy     Employee @relation(fields: [recordedById], references: [id])
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Performance (Balanced Scorecard), six-monthly cycles
// ---------------------------------------------------------------------------

enum PerformanceCycleStatus {
  OPEN
  CLOSED
}

/**
 * GOAL_SETTING -> GOALS_WITH_EMPLOYEE -> GOALS_APPROVAL -> ACTIVE -> MANAGER_REVIEW -> SIGN_OFF -> COMPLETED (-> APPEAL -> COMPLETED) -> ACKNOWLEDGED
 */
enum ScorecardStage {
  GOAL_SETTING // the Line Manager drafts the KPIs
  GOALS_WITH_EMPLOYEE // the employee acknowledges them or asks for changes
  GOALS_APPROVAL // with the HOD (approval engine)
  ACTIVE // goals agreed; check-ins; self-review once the review window opens
  MANAGER_REVIEW // the employee has submitted the self-review
  SIGN_OFF // HOD then HR (approval engine); HR may calibrate
  COMPLETED // result released to the employee
  APPEAL // the employee appealed to HR (once); HR's decision is final
  ACKNOWLEDGED // the employee has acknowledged the result
}

enum BscPerspective {
  FINANCIAL
  CUSTOMER
  INTERNAL_PROCESS
  LEARNING_GROWTH
}

model PerformanceCycle {
  id              Int                    @id @default(autoincrement())
  name            String
  startDate       DateTime               @db.Date
  endDate         DateTime               @db.Date
  goalsDueDate    DateTime               @db.Date
  checkInDate     DateTime?              @db.Date
  reviewOpensDate DateTime               @db.Date
  reviewDueDate   DateTime               @db.Date
  status          PerformanceCycleStatus @default(OPEN)
  createdById     Int
  createdBy       Employee               @relation(fields: [createdById], references: [id])
  createdAt       DateTime               @default(now())
  closedAt        DateTime?
  scorecards      Scorecard[]
}

model Scorecard {
  id         Int              @id @default(autoincrement())
  cycleId    Int
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id])
  employeeId Int
  employee   Employee         @relation("ScorecardEmployee", fields: [employeeId], references: [id])
  stage      ScorecardStage   @default(GOAL_SETTING)

  goalsSetById        Int?
  goalsSetBy          Employee? @relation("ScorecardGoalsSetBy", fields: [goalsSetById], references: [id])
  goalsSentAt         DateTime?
  goalsAcknowledgedAt DateTime?
  employeeGoalComment String? // the employee's comment when acknowledging or asking for changes
  goalsRequestId      Int?      @unique // current goal approval (HOD)
  goalsRequest        Request?  @relation("ScorecardGoals", fields: [goalsRequestId], references: [id])

  selfSubmittedAt    DateTime?
  selfComment        String?
  reviewedById       Int?
  reviewedBy         Employee? @relation("ScorecardReviewedBy", fields: [reviewedById], references: [id])
  managerSubmittedAt DateTime?
  managerComment     String?
  reviewRequestId    Int?      @unique // current result sign-off (HOD -> HR)
  reviewRequest      Request?  @relation("ScorecardReview", fields: [reviewRequestId], references: [id])

  finalScore         Decimal?  @db.Decimal(4, 2) // weighted 1-5
  finalBand          String?
  completedAt        DateTime?
  employeeAckAt      DateTime?
  employeeAckComment String?

  appealReason      String?
  appealedAt        DateTime?
  appealDecision    String?
  appealDecidedAt   DateTime?
  appealDecidedById Int?
  appealDecidedBy   Employee? @relation("ScorecardAppealDecidedBy", fields: [appealDecidedById], references: [id])
  appealChanged     Boolean?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  kpis        ScorecardKpi[]
  checkIns    ScorecardCheckIn[]
  adjustments RatingAdjustment[]

  @@unique([cycleId, employeeId])
}

model ScorecardKpi {
  id             Int                @id @default(autoincrement())
  scorecardId    Int
  scorecard      Scorecard          @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  order          Int
  perspective    BscPerspective
  title          String
  measure        String
  target         String
  weight         Int // percent; the scorecard's weights total 100
  actual         String?
  selfRating     Int?
  selfComment    String?
  managerRating  Int?
  managerComment String?
  finalRating    Int? // the manager's rating, or HR's calibrated one
  adjustments    RatingAdjustment[]
}

/**
 * Mid-point check-in: comments only, no score.
 */
model ScorecardCheckIn {
  id          Int       @id @default(autoincrement())
  scorecardId Int
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  authorId    Int
  author      Employee  @relation(fields: [authorId], references: [id])
  comment     String
  createdAt   DateTime  @default(now())
}

/**
 * HR calibration: every change of a rating, with the reason.
 */
model RatingAdjustment {
  id          Int          @id @default(autoincrement())
  scorecardId Int
  scorecard   Scorecard    @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  kpiId       Int
  kpi         ScorecardKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  fromRating  Int
  toRating    Int
  reason      String
  kind        String       @default("CALIBRATION") // CALIBRATION or APPEAL
  byId        Int
  by          Employee     @relation(fields: [byId], references: [id])
  createdAt   DateTime     @default(now())
}

/**
 * KPIs HR saved for a department; a Line Manager can start a scorecard from it.
 */
model PerformanceTemplate {
  id           Int        @id @default(autoincrement())
  departmentId Int        @unique
  department   Department @relation(fields: [departmentId], references: [id])
  kpis         Json
  updatedById  Int
  updatedBy    Employee   @relation(fields: [updatedById], references: [id])
  updatedAt    DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Manpower Requisition and internal jobs
// ---------------------------------------------------------------------------

enum RequisitionReason {
  NEW
  REPLACEMENT
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
}

/**
 * DRAFT -> SUBMITTED (approval) -> APPROVED -> POSTED -> FILLED; or CANCELLED
 */
enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  FILLED
  CANCELLED
}

enum PostingScope {
  INTERNAL
  EXTERNAL
  BOTH
}

enum ApplicationStage {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  NOT_SELECTED
  WITHDRAWN
}

model Requisition {
  id              Int               @id @default(autoincrement())
  status          RequisitionStatus @default(DRAFT)
  requestedById   Int
  requestedBy     Employee          @relation("RequisitionRequester", fields: [requestedById], references: [id])
  requestId       Int?              @unique // the approval request once submitted
  request         Request?          @relation(fields: [requestId], references: [id])
  departmentId    Int
  department      Department        @relation(fields: [departmentId], references: [id])
  title           String
  grade           String?
  headcount       Int               @default(1)
  employmentType  EmploymentType    @default(PERMANENT)
  reportsToId     Int? // the hiring manager
  reportsTo       Employee?         @relation("RequisitionReportsTo", fields: [reportsToId], references: [id])
  targetStartDate DateTime          @db.Date
  justification   String
  skills          String?
  jdPath          String?
  jdName          String?

  reason             RequisitionReason
  exitCaseId         Int? // replacement for a leaver
  exitCase           ExitCase?         @relation(fields: [exitCaseId], references: [id])
  replacesEmployeeId Int?
  replacesEmployee   Employee?         @relation("RequisitionReplaces", fields: [replacesEmployeeId], references: [id])
  gradeChanged       Boolean           @default(false)
  overHeadcount      Boolean           @default(false)

  // Salary: a suggestion from the requester; Finance confirms the budget at its step
  suggestedSalaryMin  Decimal?  @db.Decimal(12, 2)
  suggestedSalaryMax  Decimal?  @db.Decimal(12, 2)
  salaryMin           Decimal?  @db.Decimal(12, 2)
  salaryMax           Decimal?  @db.Decimal(12, 2)
  budgetNote          String?
  budgetConfirmedById Int?
  budgetConfirmedBy   Employee? @relation("RequisitionBudgetBy", fields: [budgetConfirmedById], references: [id])
  budgetConfirmedAt   DateTime?

  // Posting (HR)
  scope        PostingScope?
  description  String?
  requirements String?
  postedAt     DateTime?
  postedById   Int?
  postedBy     Employee?     @relation("RequisitionPostedBy", fields: [postedById], references: [id])
  externalFrom DateTime?     @db.Date // external candidates from this date (internal-only window first)
  closingDate  DateTime?     @db.Date

  closedAt     DateTime?
  closedById   Int?
  closedBy     Employee?        @relation("RequisitionClosedBy", fields: [closedById], references: [id])
  closedReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([status])
}

model JobApplication {
  id                Int                 @id @default(autoincrement())
  requisitionId     Int
  requisition       Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  employeeId        Int? // internal applicant
  employee          Employee?           @relation("ApplicationApplicant", fields: [employeeId], references: [id])
  candidateName     String? // external candidate, added by HR
  candidateEmail    String?
  candidatePhone    String?
  note              String?
  cvPath            String?
  cvName            String?
  stage             ApplicationStage    @default(APPLIED)
  managerNotifiedAt DateTime? // the applicant's current manager is told at shortlisting
  hiredEmployeeId   Int?
  hiredEmployee     Employee?           @relation("ApplicationHired", fields: [hiredEmployeeId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  events            ApplicationEvent[]
  feedback          InterviewFeedback[]

  @@unique([requisitionId, employeeId])
}

model ApplicationEvent {
  id            Int              @id @default(autoincrement())
  applicationId Int
  application   JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         ApplicationStage
  note          String?
  byId          Int
  by            Employee         @relation(fields: [byId], references: [id])
  createdAt     DateTime         @default(now())
}

model InterviewFeedback {
  id             Int            @id @default(autoincrement())
  applicationId  Int
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId       Int
  author         Employee       @relation(fields: [authorId], references: [id])
  recommendation String // HIRE, MAYBE or NO_HIRE
  comment        String
  createdAt      DateTime       @default(now())
}
