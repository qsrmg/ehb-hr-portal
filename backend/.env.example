# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi

# PostgreSQL 18 runs on port 5433
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5433/hr_ms?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Initial password for imported / newly created employees (they must change it on first login)
DEFAULT_PASSWORD=Welcome@123

# File storage (pay slips, attachments, policies)
UPLOAD_DIR=uploads

# Email. Development: run Mailpit (npm run mailpit) and open http://localhost:8025 to read every email.
# Leave SMTP_HOST empty to only log emails to the console. Production: your real SMTP server.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EHB HR Portal <hr-portal@ehb.local>"
